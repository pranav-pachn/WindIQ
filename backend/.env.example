# ============================================================================
# WindIQ Backend Environment Configuration Template (Phase 2.1)
# ============================================================================

APP_NAME="WindIQ API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# PostgreSQL Database Connection
# In Docker Compose, use host 'db'. On host localhost, use 'localhost'.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/windiq"

# Cross-Origin Resource Sharing (JSON array or comma-separated string)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Market & Cutoff Configuration
TIMEZONE="Europe/London"
DECISION_CUTOFF_HOUR=9
DECISION_CUTOFF_MINUTE=0

