# ============================================================================
# WindIQ Backend Environment Configuration Template (.env.example)
# ============================================================================

# Service & Environment Settings
APP_NAME="WindIQ API"
APP_ENV="development"
DEBUG=true
PORT=8000
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# ----------------------------------------------------------------------------
# Database Connection (PostgreSQL)
# ----------------------------------------------------------------------------
# Docker Compose: postgresql+asyncpg://postgres:postgres@db:5432/windiq
# Host Localhost: postgresql+asyncpg://postgres:postgres@localhost:5432/windiq (or :5435 if connecting to Docker port mapping)
# Supabase Pooler: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/windiq"

# Database Pool Configuration
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=300
DB_DISABLE_STATEMENT_CACHE=false

# ----------------------------------------------------------------------------
# Redis Distributed Coordination & Rate Limiting
# ----------------------------------------------------------------------------
# Docker Compose: redis://:windiq_redis_dev_secret_pass@windiq-redis:6379/0
# Host Localhost: redis://:windiq_redis_dev_secret_pass@localhost:6385/0
# Upstash Cloud:  rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL="redis://:windiq_redis_dev_secret_pass@windiq-redis:6379/0"
REDIS_PASSWORD="windiq_redis_dev_secret_pass"
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# ----------------------------------------------------------------------------
# Rate Limiting & Fail-Closed Policies
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED_DEFAULT=false
RATE_LIMIT_ANONYMOUS_RPM=30
RATE_LIMIT_VIEWER_RPM=120
RATE_LIMIT_ANALYST_RPM=300
RATE_LIMIT_ADMIN_RPM=1200
RATE_LIMIT_LOGIN_RPM=10
RATE_LIMIT_REFRESH_RPM=30
RATE_LIMIT_KEYS_RPM=10
RATE_LIMIT_HEAVY_ANALYTICS_RPM=60
RATE_LIMIT_REVISIONS_RPM=30

# ----------------------------------------------------------------------------
# Authentication, JWT & Cookie Security
# ----------------------------------------------------------------------------
JWT_SECRET_KEY="windiq_super_secret_jwt_signing_key_for_development_purposes_only_32bytes"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="windiq-api"
JWT_AUDIENCE="windiq-client"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"
AUTH_ENFORCE=true

# ----------------------------------------------------------------------------
# CORS & Ingress Security
# ----------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'
TRUSTED_PROXIES='["127.0.0.1/32", "::1/128", "172.16.0.0/12", "10.0.0.0/8"]'

# ----------------------------------------------------------------------------
# Scheduler & Pipeline Automation
# ----------------------------------------------------------------------------
# Set to false for free cloud demo mode (Render Free Web Service sleeping container)
SCHEDULER_ENABLED=true
WINDFOR_POLL_INTERVAL_MINUTES=30
FUELHH_POLL_INTERVAL_MINUTES=15
EVALUATION_POLL_INTERVAL_MINUTES=15
SCHEDULER_LOCK_ID=24566378415277825

# ----------------------------------------------------------------------------
# Market Cutoff & Domain Provenance
# ----------------------------------------------------------------------------
TIMEZONE="Europe/London"
DECISION_CUTOFF_HOUR=9
DECISION_CUTOFF_MINUTE=0
