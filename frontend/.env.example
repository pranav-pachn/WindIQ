# ============================================================================
# WindIQ Frontend Environment Configuration Template (.env.example)
# ============================================================================

# API Base URL:
# Leave blank ("") to use same-origin relative paths (/api/v1/...) via reverse
# proxy (Vercel rewrites in cloud deployment, Nginx in Docker Compose, or
# Vite dev server proxy on port 3000 -> 8001).
# Only specify an explicit URL if connecting cross-origin without an ingress proxy.
VITE_API_BASE_URL=
