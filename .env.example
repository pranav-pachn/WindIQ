# ============================================================================
# WindIQ Platform Environment Configuration Template (Phase 3.1)
# ============================================================================

APP_NAME="WindIQ API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# PostgreSQL Credentials (for local Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=windiq
POSTGRES_PORT=5432

# Backend Database URL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/windiq"

# Cross-Origin Resource Sharing
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Redis 7 Distributed Coordination Store
REDIS_PORT=6379
REDIS_PASSWORD="windiq_redis_dev_secret_pass"
REDIS_URL="redis://:windiq_redis_dev_secret_pass@windiq-redis:6379/0"

# Ingress Trusted Proxy CIDRs (right-to-left resolution)
TRUSTED_PROXIES='["127.0.0.1/32", "::1/128", "172.16.0.0/12", "10.0.0.0/8"]'

# Distributed Rate Limiting & Fail-Closed Policies
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED_DEFAULT=false

# Authentication & JWT Security Settings
JWT_SECRET_KEY="windiq_super_secret_jwt_signing_key_for_development_purposes_only_32bytes"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="windiq-api"
JWT_AUDIENCE="windiq-client"
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE="lax"
AUTH_ENFORCE=true

# Market & Decision Cutoff Configuration
TIMEZONE="Europe/London"
DECISION_CUTOFF_HOUR=9
DECISION_CUTOFF_MINUTE=0

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8001
